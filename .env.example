APP_NAME=PawRide API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./pawride.db
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=30
REFRESH_TOKEN_EXP_DAYS=30
OTP_EXP_MINUTES=10
DEFAULT_CURRENCY=usd

# Fare configuration
BASE_FARE=8.0
PER_KM_FARE=2.5
PER_MINUTE_FARE=0.4
SIZE_SURCHARGE_MEDIUM=2.0
SIZE_SURCHARGE_LARGE=4.0
SIZE_SURCHARGE_XLARGE=6.0
ADDITIONAL_DOG_FEE=5.0

# Platform economics
DEFAULT_DRIVER_COMMISSION_RATE=0.75
FREE_CANCEL_WINDOW_MINUTES=2
CANCEL_FEE_EN_ROUTE=5.0
CANCEL_FEE_WITH_DOG=15.0

# Dispatch/matching
DISPATCH_OFFER_TIMEOUT_SECONDS=15
DISPATCH_INITIAL_RADIUS_KM=3.0
DISPATCH_RADIUS_STEP_KM=2.0
DISPATCH_MAX_RADIUS_KM=20.0
DRIVER_MINIMUM_RATING=4.0
SCHEDULED_MATCH_LEAD_MINUTES=30

# Camera / payouts / pass
CAMERA_AUTO_SNAPSHOT_INTERVAL_MINUTES=5
INSTANT_PAYOUT_FEE_PERCENT=1.5
WEEKLY_PAYOUT_WEEKDAY=0
DEFAULT_PASS_PRICE_MONTHLY=29.99
DEFAULT_PASS_DISCOUNT_PERCENT=10.0
ENABLE_BACKGROUND_JOBS=true
